---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CommunityBlock from '../components/CommunityBlock.astro';
import { url } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	category?: string;
	related?: CollectionEntry<'blog'>[];
}

const { title, description, pubDate, updatedDate, heroImage, category, related = [] } = Astro.props;
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const fbShareURL = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageURL)}`;
---

<html lang="fr">
	<head>
		<BaseHead title={title} description={description} pubDate={pubDate} category={category} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article class="article">
				{heroImage && (
					<img class="article-cover" width={1020} height={510} src={heroImage} alt="" />
				)}
				<header class="article-header">
					<FormattedDate date={pubDate} class="article-date" />
					{
						category && (
							<a href={url(`categories/${encodeURIComponent(category)}`)} class="badge">
								{category}
							</a>
						)
					}
					{
						updatedDate && (
							<p class="article-updated">Mis à jour le <FormattedDate date={updatedDate} /></p>
						)
					}
					<h1>{title}</h1>
				</header>
				<div class="prose">
					<slot />
				</div>
				<footer class="share">
					<span class="share-label">Partager cet article :</span>
					<a class="btn" href={fbShareURL} target="_blank" rel="noopener">
						Partager sur Facebook
					</a>
				</footer>
			</article>
			{related.length > 0 && (
				<section class="related">
					<h2 class="related-title">À lire ensuite</h2>
					<ul class="related-list">
						{related.map((p) => (
							<li class="related-item">
								<a class="related-link" href={url(`blog/${p.id}/`)}>
									{p.data.category && <span class="badge">{p.data.category}</span>}
									<span class="related-name">{p.data.title}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
			<CommunityBlock />
		</main>
		<Footer />
	</body>
</html>
