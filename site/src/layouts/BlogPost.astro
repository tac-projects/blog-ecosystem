---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CommunityBlock from '../components/CommunityBlock.astro';
import { url } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const fbShareURL = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageURL)}`;
---

<html lang="fr">
	<head>
		<BaseHead title={title} description={description} pubDate={pubDate} category={category} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article class="article">
				{heroImage && (
					<img class="article-cover" width={1020} height={510} src={heroImage} alt="" />
				)}
				<header class="article-header">
					<FormattedDate date={pubDate} class="article-date" />
					{
						category && (
							<a href={url(`categories/${encodeURIComponent(category)}`)} class="badge">
								{category}
							</a>
						)
					}
					{
						updatedDate && (
							<p class="article-updated">Mis à jour le <FormattedDate date={updatedDate} /></p>
						)
					}
					<h1>{title}</h1>
				</header>
				<div class="prose">
					<slot />
				</div>
				<footer class="share">
					<span class="share-label">Partager cet article :</span>
					<a class="btn" href={fbShareURL} target="_blank" rel="noopener">
						Partager sur Facebook
					</a>
				</footer>
			</article>
			<CommunityBlock />
		</main>
		<Footer />
	</body>
</html>
