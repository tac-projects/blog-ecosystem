---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import CommunityBlock from '../components/CommunityBlock.astro';
import { url } from '../consts';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	heroImage?: string;
	category?: string;
	related?: CollectionEntry<'blog'>[];
}

const { title, description, pubDate, updatedDate, heroImage, category, related = [] } = Astro.props;
const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const fbShareURL = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageURL)}`;
---

<html lang="fr">
	<head>
		<BaseHead title={title} description={description} pubDate={pubDate} category={category} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article class="article">
				{heroImage && (
					<img class="article-cover" width={1020} height={510} src={heroImage} alt="" />
				)}
				<header class="article-header">
					<FormattedDate date={pubDate} class="article-date" />
					{
						category && (
							<a href={url(`categories/${encodeURIComponent(category)}`)} class="badge">
								{category}
							</a>
						)
					}
					{
						updatedDate && (
							<p class="article-updated">Mis à jour le <FormattedDate date={updatedDate} /></p>
						)
					}
					<h1>{title}</h1>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
			<div class="post-actions">
				{related.length > 0 && (
					<section class="related">
						<h2 class="related-title">À lire ensuite</h2>
						<ul class="related-list">
							{related.map((p) => (
								<li class="related-item">
									<a class="related-link" href={url(`blog/${p.id}/`)}>
										{p.data.heroImage && (
											<img
												class="related-thumb"
												width={160}
												height={90}
												src={p.data.heroImage}
												alt=""
												loading="lazy"
											/>
										)}
										<span class="related-info">
											{p.data.category && <span class="badge">{p.data.category}</span>}
											<span class="related-name">{p.data.title}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)}
				<CommunityBlock />
			</div>
		</main>

		<a class="share-sticky" href={fbShareURL} target="_blank" rel="noopener">
			<svg viewBox="0 0 24 24" width="18" height="18" fill="#fff" aria-hidden="true">
				<path
					d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.026 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
				/>
			</svg>
			<span>Partager cet article</span>
		</a>

		<Footer />
		<script>
			const sticky = document.querySelector('.share-sticky');
			if (sticky && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				sticky.classList.add('is-visible', 'is-pulsing');
			}
		</script>
	</body>
</html>
