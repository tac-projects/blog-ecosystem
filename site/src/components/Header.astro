---
import { SITE_TITLE, FACEBOOK_URL, url } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2 class="site-logo">
			<a href={url('')}>{SITE_TITLE}</a>
		</h2>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href={url('')}>Accueil</HeaderLink>
				<HeaderLink href={url('blog')}>Blog</HeaderLink>
				<HeaderLink href={url('categories')}>Catégories</HeaderLink>
				<HeaderLink href={url('about')}>À propos</HeaderLink>
			</div>
			<a class="facebook-link" href={FACEBOOK_URL} target="_blank" rel="noopener">
				<span class="sr-only">Suivre la page Facebook</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20" fill="currentColor">
					<path
						d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.026 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
					/>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0.75em 1em;
		background: rgba(255, 255, 255, 0.94);
		border-bottom: 1px solid var(--accent-soft);
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(8px);
	}
	.site-logo {
		margin: 0;
		font-size: 1.6em;
		font-family: "Libre Bodoni", serif;
		font-weight: 700;
		line-height: 1.2;
	}
	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	.site-logo a {
		color: var(--title);
	}
	.site-logo a:hover {
		color: var(--accent);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.5em;
		max-width: 960px;
		margin: auto;
	}
	nav a {
		padding: 0.75em 0.5em;
		color: var(--text);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		cursor: pointer;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}
	nav a:hover {
		color: var(--accent);
	}
	nav a.active {
		text-decoration: none;
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1em;
	}
	.facebook-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 999px;
		background: var(--accent);
		color: #fff;
		text-decoration: none;
		transition:
			background 0.2s ease,
			transform 0.2s ease;
	}
	.facebook-link:hover {
		background: var(--accent-dark);
		transform: translateY(-2px);
		color: #fff;
	}
	@media (max-width: 720px) {
		.internal-links {
			display: none;
		}
	}
</style>
