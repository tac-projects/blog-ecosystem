---
import FormattedDate from './FormattedDate.astro';
import { url } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<li class="card">
	<a href={url(`blog/${post.id}/`)} class="card-link">
		{post.data.heroImage && (
			<img width={720} height={360} src={post.data.heroImage} alt="" loading="lazy" />
		)}
		<div class="card-body">
			<FormattedDate date={post.data.pubDate} class="date" />
			{post.data.category && <span class="badge">{post.data.category}</span>}
			<h4>{post.data.title}</h4>
			<p class="excerpt">{post.data.description}</p>
		</div>
	</a>
</li>
