---
import { SITE_TITLE, FACEBOOK_URL, url } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<p class="footer-title">🐈 {SITE_TITLE}</p>
			<p class="footer-tagline">Des milliers d'amoureux des chats, un article chaque jour.</p>
		</div>
		<div class="footer-right">
			<a class="footer-fb" href={FACEBOOK_URL} target="_blank" rel="noopener">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="#1877F2" aria-hidden="true">
					<path
						d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.026 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
					/>
				</svg>
				Nous suivre sur Facebook
			</a>
			<nav class="legal-links" aria-label="Liens légaux">
				<a href={url('mentions-legales')}>Mentions légales</a>
				<a href={url('politique-de-confidentialite')}>Politique de confidentialité</a>
			</nav>
		</div>
	</div>
	<p class="footer-copyright">
		&copy; {today.getFullYear()} {SITE_TITLE}. Tous droits réservés.
	</p>
</footer>
