---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<p>
		&copy; {today.getFullYear()} {SITE_TITLE}. Tous droits réservés.
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 4em 1em;
		border-top: 1px solid var(--accent-soft);
		color: var(--text-soft);
		text-align: center;
		font-size: 0.9rem;
		background: #f5eee4;
	}
	footer p {
		margin: 0;
	}
</style>
