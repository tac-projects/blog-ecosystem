---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, url } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const cats = new Set(posts.map((p) => p.data.category || 'Mode de vie'));
	return [...cats].map((cat) => ({ params: { cat }, props: { cat } }));
}

const { cat } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((p) => (p.data.category || 'Mode de vie') === cat)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`${cat}`} description={`Articles de la catégorie ${cat} sur ${SITE_TITLE}`} />
		<style>
			.section-title {
				text-align: center;
				margin-bottom: 2rem;
			}
			.back {
				display: inline-block;
				margin-bottom: 1.5rem;
				text-decoration: none;
				color: var(--text-soft);
			}
			.back:hover {
				color: var(--accent);
			}
			ul {
				list-style: none;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
			}
			li a {
				display: block;
				background: var(--card);
				border: 1px solid var(--accent-soft);
				border-radius: 12px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease,
					border-color 0.25s ease;
				box-shadow: 0 2px 10px rgba(45, 35, 32, 0.06);
			}
			li a:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 28px rgba(45, 35, 32, 0.12);
				border-color: var(--accent);
			}
			li img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
				border-radius: 0;
			}
			.card-body {
				padding: 1.25rem;
			}
			.card-body h2 {
				margin-bottom: 0.25rem;
			}
			.card-body p {
				margin: 0;
				color: var(--text-soft);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<a class="back" href={url('categories')}>← Toutes les catégories</a>
				<h1 class="section-title">{cat}</h1>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={url(`blog/${post.id}/`)}>
								{post.data.heroImage && (
									<img src={post.data.heroImage} alt="" loading="lazy" width={720} height={360} />
								)}
								<div class="card-body">
									<h2>{post.data.title}</h2>
									<p>
										<FormattedDate date={post.data.pubDate} />
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
