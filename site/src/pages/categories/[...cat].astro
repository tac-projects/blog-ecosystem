---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE_TITLE, url } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const cats = new Set(posts.map((p) => p.data.category || 'Mode de vie'));
	return [...cats].map((cat) => ({ params: { cat }, props: { cat } }));
}

const { cat } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((p) => (p.data.category || 'Mode de vie') === cat)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={`${cat}`} description={`Articles de la catégorie ${cat} sur ${SITE_TITLE}`} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<a class="back" href={url('categories')}>← Toutes les catégories</a>
				<h1 class="section-title">{cat}</h1>
				<ul class="grid">
					{posts.map((post) => <PostCard post={post} />)}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
