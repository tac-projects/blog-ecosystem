---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, url } from '../../consts';

const posts = await getCollection('blog');
const counts = new Map();
for (const post of posts) {
	const cat = post.data.category || 'Mode de vie';
	counts.set(cat, (counts.get(cat) || 0) + 1);
}
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title="Catégories" description={`Les catégories d'articles de ${SITE_TITLE}`} />
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h1 class="section-title">Catégories</h1>
				<ul class="grid">
					{categories.map(([cat, count]) => (
						<li class="card">
							<a class="card-link" href={url(`categories/${encodeURIComponent(cat)}`)}>
								<div class="card-body">
									<h2>{cat}</h2>
									<p class="excerpt">
										{count} article{count > 1 ? 's' : ''}
									</p>
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
