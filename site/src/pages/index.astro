---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommunityBlock from '../components/CommunityBlock.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, FACEBOOK_URL, url } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [featured, ...rest] = posts;
const latest = rest.slice(0, 6);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1 class="hero-title">
					Rejoins <span class="hero-accent">43 000+</span>
					<span class="hero-line2">amoureux des chats</span>
				</h1>
				<p class="hero-desc">{SITE_DESCRIPTION}</p>
				<div class="hero-cta-wrap">
					<ul class="hero-trust">
						<li>
							<strong>43 000+</strong> membres sur Facebook
						</li>
						<li><strong>Chaque jour</strong> de nouveaux articles</li>
						<li><strong>100% gratuit</strong> sans inscription</li>
					</ul>
					<a class="btn hero-cta" href={FACEBOOK_URL} target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
							<path
								d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.026 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.93-1.956 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
							/>
						</svg>
						Rejoins-nous maintenant
					</a>
				</div>
			</section>

			{featured && (
				<section class="featured-section">
					<a href={url(`blog/${featured.id}/`)} class="featured">
						{featured.data.heroImage && (
							<img src={featured.data.heroImage} alt="" width={1020} height={510} />
						)}
						<div class="featured-body">
							<span class="featured-tag">L'article du jour</span>
							{featured.data.category && <span class="badge">{featured.data.category}</span>}
							<h2>{featured.data.title}</h2>
							<p class="featured-excerpt">{featured.data.description}</p>
						</div>
					</a>
				</section>
			)}

			<section>
				<ul class="grid">
					{latest.map((post) => <PostCard post={post} />)}
				</ul>
				<div class="more-wrap">
					<a class="btn" href={url('blog')}>Voir nos autres articles</a>
				</div>
			</section>

			<CommunityBlock />
		</main>
		<Footer />
	</body>
</html>

