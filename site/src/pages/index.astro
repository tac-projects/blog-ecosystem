---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommunityBlock from '../components/CommunityBlock.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION, FACEBOOK_URL, url } from '../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const [featured, ...rest] = posts;
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1 class="hero-title">{SITE_TITLE}</h1>
				<p class="hero-desc">{SITE_DESCRIPTION}</p>
				<ul class="hero-trust">
					<li>
						<strong>43 000+</strong> membres sur Facebook
					</li>
					<li><strong>Chaque jour</strong> un nouvel article</li>
					<li><strong>100% gratuit</strong> sans inscription</li>
				</ul>
				<a class="hero-cta" href={FACEBOOK_URL} target="_blank" rel="noopener">
					Rejoindre 43 000+ amoureux des chats
				</a>
			</section>

			{featured && (
				<section class="featured-section">
					<a href={url(`blog/${featured.id}/`)} class="featured">
						{featured.data.heroImage && (
							<img src={featured.data.heroImage} alt="" width={1020} height={510} />
						)}
						<div class="featured-body">
							<span class="featured-tag">Dernier article</span>
							<h2>{featured.data.title}</h2>
							<p class="featured-excerpt">{featured.data.description}</p>
						</div>
					</a>
				</section>
			)}

			<section>
				<ul class="grid">
					{rest.map((post) => <PostCard post={post} />)}
				</ul>
			</section>

			<CommunityBlock />
		</main>
		<Footer />
		<style>
			.hero {
				text-align: center;
				padding: 1.5rem 0 3rem;
				margin-bottom: 2.5rem;
			}
			.hero-title {
				font-size: 3.2em;
				margin-bottom: 0.25em;
			}
			.hero-desc {
				color: var(--text-soft);
				font-size: 1.15rem;
				max-width: 640px;
				margin: 0 auto;
			}
			.hero-trust {
				display: flex;
				justify-content: center;
				flex-wrap: wrap;
				gap: 1rem 2.5rem;
				list-style: none;
				padding: 0;
				margin: 1.6rem auto 0;
				font-size: 0.98rem;
				color: var(--text-soft);
			}
			.hero-trust li {
				display: flex;
				align-items: center;
				gap: 0.45em;
			}
			.hero-trust li::before {
				content: "🐾";
			}
			.hero-trust strong {
				color: var(--accent-dark);
				font-weight: 600;
			}
			.hero-cta {
				display: inline-block;
				margin-top: 1.8rem;
				background: var(--accent);
				color: #fff;
				font-weight: 600;
				text-decoration: none;
				padding: 0.75em 1.8em;
				border-radius: 999px;
				transition:
					background 0.2s ease,
					transform 0.2s ease;
				cursor: pointer;
			}
			.hero-cta:hover {
				background: var(--accent-dark);
				transform: translateY(-2px);
				color: #fff;
			}
			.featured-section {
				margin-bottom: 2.5rem;
			}
			.featured {
				display: grid;
				grid-template-columns: 1fr 1fr;
				background: var(--card);
				border: 1px solid var(--accent-soft);
				border-radius: 12px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				box-shadow: 0 2px 12px rgba(45, 35, 32, 0.08);
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease;
				cursor: pointer;
			}
			.featured:hover {
				transform: translateY(-3px);
				box-shadow: 0 12px 32px rgba(45, 35, 32, 0.14);
			}
			.featured img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.featured-body {
				padding: 2rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.featured-tag {
				display: inline-block;
				align-self: flex-start;
				background: var(--accent);
				color: #fff;
				font-family: "Public Sans", sans-serif;
				font-size: 0.75rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				padding: 0.3em 0.9em;
				border-radius: 999px;
				margin-bottom: 1rem;
			}
			.featured-excerpt {
				color: var(--text-soft);
				margin: 0;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				list-style: none;
				padding: 0;
			}
			@media (max-width: 720px) {
				.featured {
					grid-template-columns: 1fr;
				}
				.featured img {
					aspect-ratio: 16/9;
					height: auto;
				}
			}
		</style>
	</body>
</html>
