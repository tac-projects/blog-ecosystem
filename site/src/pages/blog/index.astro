---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, url } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.section-title {
				text-align: center;
				margin-bottom: 2rem;
				color: var(--title);
			}
			.badge {
				display: inline-block;
				background: var(--bg);
				border: 1px solid var(--accent-soft);
				color: var(--accent-dark);
				font-size: 0.78rem;
				font-weight: 600;
				padding: 0.2em 0.8em;
				border-radius: 999px;
				margin: 0.3rem 0 0.2rem;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li a {
				display: block;
				text-decoration: none;
				transition:
					transform 0.25s ease,
					box-shadow 0.25s ease;
				border-radius: 12px;
				padding: 1rem;
				background: var(--card);
				border: 1px solid var(--accent-soft);
				box-shadow: 0 2px 10px rgba(45, 35, 32, 0.06);
			}
			ul li a:hover {
				transform: translateY(-3px);
				box-shadow: 0 10px 28px rgba(45, 35, 32, 0.12);
				border-color: var(--accent);
			}
			ul li img {
				width: 100%;
				aspect-ratio: 16/9;
				object-fit: cover;
				margin-bottom: 0.5rem;
				border-radius: 8px;
			}
			.title {
				margin: 0.4rem 0 0.25rem;
				color: var(--title);
				line-height: 1.25;
			}
			.date {
				margin: 0;
				color: var(--text-soft);
				font-size: 0.85rem;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}
			ul li a:hover .title,
			ul li a:hover .date {
				color: var(--accent);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<h2 class="section-title">Tous les articles</h2>
				<ul>
					{posts.map((post) => (
						<li>
							<a href={url(`blog/${post.id}/`)}>
								{post.data.heroImage && (
									<img width={720} height={360} src={post.data.heroImage} alt="" loading="lazy" />
								)}
								{post.data.category && (
									<span class="badge">{post.data.category}</span>
								)}
								<h4 class="title">{post.data.title}</h4>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
